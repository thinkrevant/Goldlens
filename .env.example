# Copy this file to .env (same folder) and fill in the values. Never commit .env.

# AI analyst (daily brief, alert explanations, Q&A). Set any of these.
# They are tried in this order; one that fails for lack of credits is skipped automatically.
# Claude: https://console.anthropic.com
ANTHROPIC_API_KEY=
# xAI Grok: https://console.x.ai (the account needs credits). XAI_MODEL is optional.
XAI_API_KEY=
XAI_MODEL=grok-4.7
# OpenRouter: https://openrouter.ai/keys. Free models by default (50 requests/day).
# OPENROUTER_MODEL is optional; leave it empty to use the free defaults.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Upstox live MCX quotes. Free, read-only, valid 1 year.
# Upstox Developer Apps -> Analytics tab -> Generate Token -> copy it here.
UPSTOX_ANALYTICS_TOKEN=

# Optional: seconds between live refreshes (minimum 5).
UPSTOX_REFRESH_SECONDS=10

# Telegram alerts. Create a bot with @BotFather, paste its token here, press Start in the bot,
# then run: python -m goldlens.notify --setup   (it fills in TELEGRAM_CHAT_ID for you)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_LANGUAGE=English
# Optional: public dashboard link added at the end of each brief
GOLDLENS_DASHBOARD_URL=
